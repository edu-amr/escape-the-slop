{
  "name": "escape-the-slop",
  "version": "0.1.0",
  "private": true,
  "description": "Curadoria de bibliotecas de UI, ícones e ilustrações com personalidade, para fugir do visual genérico de IA.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edu-amr/escape-the-slop.git"
  },
  "bugs": {
    "url": "https://github.com/edu-amr/escape-the-slop/issues"
  },
  "homepage": "https://github.com/edu-amr/escape-the-slop#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:libs": "tsx scripts/check-libs.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:libs",
    "previews": "tsx scripts/capture.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
